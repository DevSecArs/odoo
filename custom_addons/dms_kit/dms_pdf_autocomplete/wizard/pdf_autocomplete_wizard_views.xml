<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pdf_autocomplete_wizard_form" model="ir.ui.view">
        <field name="name">dms.pdf.autocomplete.wizard.form</field>
        <field name="model">dms.pdf.autocomplete.wizard</field>
        <field name="arch" type="xml">
            <form string="Fill PDF" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="select_recipients,map_fields,enter_values,review,ready,done"/>
                </header>
                <sheet>
                    <field name="owner_user_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="source_file_checksum" invisible="1"/>
                    <field name="target_res_model" invisible="1"/>
                    <group>
                        <field name="source_file_id"/>
                        <field name="source_filename"/>
                    </group>

                    <group invisible="state != 'select_recipients'">
                        <field name="target_model" widget="radio"/>
                        <field name="employee_ids" widget="many2many_tags"
                               invisible="target_model != 'employee'"
                               required="state == 'select_recipients' and target_model == 'employee'"/>
                        <field name="partner_ids" widget="many2many_tags"
                               invisible="target_model != 'partner'"
                               required="state == 'select_recipients' and target_model == 'partner'"/>
                        <field name="retention_days"/>
                    </group>

                    <group invisible="state != 'map_fields'">
                        <field name="save_mapping_as_default"/>
                        <field name="mapping_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="form_field_id" column_invisible="True"/>
                                <field name="target_res_model" column_invisible="True"/>
                                <field name="label"/>
                                <field name="pdf_field_name"/>
                                <field name="multiline"/>
                                <field name="fill_mode"/>
                                <field name="source_field_path"
                                       widget="DynamicModelFieldSelectorChar"
                                       options="{'model': 'target_res_model', 'follow_relations': True}"
                                       required="fill_mode == 'odoo_field'"
                                       readonly="fill_mode == 'manual'"/>
                            </list>
                        </field>
                    </group>

                    <group invisible="state != 'enter_values'">
                        <field name="current_recipient_id" readonly="1"/>
                        <field name="step_label" readonly="1"/>
                        <separator string="Manual values"/>
                        <field name="current_manual_value_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="label"/>
                                <field name="pdf_field_name"/>
                                <field name="multiline"/>
                                <field name="value"/>
                            </list>
                        </field>
                        <separator string="Values from Odoo"/>
                        <field name="current_automatic_value_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0">
                                <field name="label"/>
                                <field name="pdf_field_name"/>
                                <field name="value"/>
                            </list>
                        </field>
                        <field name="current_preview_stale" invisible="1"/>
                        <field name="current_preview_filename" invisible="1"/>
                        <field name="current_preview_pdf" widget="pdf_viewer"
                               filename="current_preview_filename" readonly="1" nolabel="1"
                               invisible="not current_preview_pdf or current_preview_stale"/>
                    </group>

                    <group invisible="state not in ['review', 'ready', 'done', 'failed']">
                        <field name="recipient_count"/>
                        <field name="batch_id" invisible="not batch_id"/>
                        <field name="recipient_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0">
                                <field name="display_name_snapshot"/>
                                <field name="email_to"/>
                                <field name="output_filename"/>
                                <field name="delivery_state"/>
                                <field name="delivery_error"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_prepare_mappings" type="object" string="Next" class="btn-primary"
                            invisible="state != 'select_recipients'"/>
                    <button name="action_prepare_values" type="object" string="Next" class="btn-primary"
                            invisible="state != 'map_fields'"/>
                    <button name="action_previous_recipient" type="object" string="Previous"
                            invisible="state != 'enter_values' or current_index == 0"/>
                    <button name="action_preview_current" type="object" string="Preview"
                            invisible="state != 'enter_values'"/>
                    <button name="action_next_recipient" type="object" string="Next" class="btn-primary"
                            invisible="state != 'enter_values'"/>
                    <button name="action_download" type="object" string="Download ZIP" class="btn-primary"
                            invisible="state not in ['review', 'ready']"/>
                    <button name="action_open_delivery" type="object" string="Deliver"
                            invisible="state not in ['review', 'ready']"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_pdf_autocomplete_wizard" model="ir.actions.act_window">
        <field name="name">Fill PDF</field>
        <field name="res_model">dms.pdf.autocomplete.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pdf_autocomplete_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
