<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pdf_delivery_wizard_form" model="ir.ui.view">
        <field name="name">dms.pdf.autocomplete.delivery.wizard.form</field>
        <field name="model">dms.pdf.autocomplete.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Deliver personalized PDFs" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sending,partial,done"/>
                </header>
                <sheet>
                    <field name="owner_user_id" invisible="1"/>
                    <field name="source_wizard_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="delivery_channel" widget="radio"/>
                            <field name="retention_days"/>
                        </group>
                        <group>
                            <field name="subject"/>
                        </group>
                    </group>
                    <field name="body_html" widget="html"/>
                    <field name="recipient_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="send_enabled"/>
                            <field name="display_name_snapshot"/>
                            <field name="output_filename"/>
                            <field name="email_to" invisible="parent.delivery_channel != 'email'"/>
                            <field name="chat_partner_id" invisible="parent.delivery_channel != 'chat'"/>
                            <field name="delivery_state"/>
                            <field name="delivery_error"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        Attachments published through Email or Odoo chat follow the Mail retention policy
                        and are not deleted by the generated-document cleanup job.
                    </div>
                </sheet>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_pdf_delivery_wizard" model="ir.actions.act_window">
        <field name="name">Deliver personalized PDFs</field>
        <field name="res_model">dms.pdf.autocomplete.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pdf_delivery_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
