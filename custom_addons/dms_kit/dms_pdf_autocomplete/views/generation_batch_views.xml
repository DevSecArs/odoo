<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dms_pdf_generation_batch_list" model="ir.ui.view">
        <field name="name">dms.pdf.generation.batch.list</field>
        <field name="model">dms.pdf.generation.batch</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="source_filename"/>
                <field name="target_model"/>
                <field name="channel"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="success_count"/>
                <field name="error_count"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>
    <record id="view_dms_pdf_generation_batch_form" model="ir.ui.view">
        <field name="name">dms.pdf.generation.batch.form</field>
        <field name="model">dms.pdf.generation.batch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="source_file_id"/>
                            <field name="source_filename"/>
                            <field name="source_checksum"/>
                            <field name="target_model"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="channel"/>
                            <field name="state"/>
                            <field name="expires_at"/>
                        </group>
                    </group>
                    <field name="field_paths_audit"/>
                    <field name="target_res_ids_audit"/>
                    <field name="result_ids" nolabel="1">
                        <list>
                            <field name="recipient_display_name"/>
                            <field name="output_filename"/>
                            <field name="output_checksum"/>
                            <field name="delivery_state"/>
                            <field name="delivery_error"/>
                            <field name="attachment_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dms_pdf_generation_batch" model="ir.actions.act_window">
        <field name="name">Generated PDF batches</field>
        <field name="res_model">dms.pdf.generation.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dms_pdf_generation_batch" name="Generated PDF batches"
              parent="dms.main_menu_dms" action="action_dms_pdf_generation_batch"
              groups="dms.group_dms_user" sequence="40"/>
</odoo>
