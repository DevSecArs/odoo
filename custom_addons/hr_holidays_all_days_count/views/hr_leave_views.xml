<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_leave_view_form_all_days_count" model="ir.ui.view">
        <field name="name">hr.leave.view.form.all.days.count</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_display']" position="replace">
                <field name="duration_display" readonly="1" invisible="leave_type_request_unit != 'hour'"/>
                <div class="d-flex flex-column gap-1" invisible="leave_type_request_unit == 'hour'">
                    <div>
                        <span>Запрашиваемые дни: </span>
                        <field name="calendar_days_count" readonly="1" nolabel="1"/>
                    </div>
                    <div>
                        <span>Количество рабочих дней: </span>
                        <field name="number_of_days" readonly="1" nolabel="1"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_tree_all_days_count" model="ir.ui.view">
        <field name="name">hr.leave.view.list.all.days.count</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_display']" position="after">
                <field name="calendar_days_count" string="Календарные дни"/>
                <field name="number_of_days" string="Рабочие дни"/>
            </xpath>
        </field>
    </record>
</odoo>
