<odoo>
    <record id="hr_offer_pdf_send_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.offer.pdf.send.wizard.form</field>
        <field name="model">hr.offer.pdf.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare PDF offer" class="o_offer_pdf_wizard" create="0" edit="1" delete="0">
                <header>
                    <button name="action_previous" string="Back" type="object" class="btn-secondary" invisible="current_index == 0 or state != 'draft'"/>
                    <button name="action_refresh_preview" string="Refresh preview" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_next" string="Next" type="object" class="btn-primary" invisible="current_index + 1 >= document_count or state != 'draft'"/>
                    <button name="action_done" string="Send" type="object" class="btn-primary" invisible="current_index + 1 != document_count or state not in ('draft', 'failed')"/>
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="current_index" invisible="1"/>
                    <field name="document_count" invisible="1"/>
                    <field name="preview_stale" invisible="1"/>
                    <field name="current_document_id" invisible="1"/>
                    <group>
                        <field name="applicant_id" readonly="1"/>
                        <field name="template_id" readonly="1"/>
                        <field name="current_document_name" string="PDF document" readonly="1"/>
                        <field name="step_label" string="Document" readonly="1"/>
                    </group>
                    <div class="alert alert-warning" invisible="not preview_stale">
                        Values have changed. Refresh the preview to view current values.
                    </div>
                    <div class="o_offer_pdf_wizard_stack">
                        <group string="Fields" class="o_offer_pdf_fields_section">
                            <field name="current_value_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" invisible="1" column_invisible="True"/>
                                    <field name="label" readonly="1"/>
                                    <field name="required" invisible="1" column_invisible="True"/>
                                    <field name="multiline" invisible="1" column_invisible="True"/>
                                    <field name="value" widget="text"/>
                                </list>
                            </field>
                        </group>
                        <group string="Preview" class="o_offer_pdf_preview_section">
                            <field name="preview_pdf" widget="pdf_viewer" filename="preview_filename" readonly="1" nolabel="1"/>
                            <field name="preview_filename" invisible="1"/>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary" invisible="state not in ('draft', 'failed')"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_offer_pdf_send_wizard" model="ir.actions.act_window">
        <field name="name">Prepare PDF offer</field>
        <field name="res_model">hr.offer.pdf.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_offer_pdf_send_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
    </record>
</odoo>
