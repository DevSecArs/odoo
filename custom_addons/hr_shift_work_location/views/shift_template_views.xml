<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shift_template_form" model="ir.ui.view">
        <field name="name">hr.shift.template.form.work.location</field>
        <field name="model">hr.shift.template</field>
        <field name="inherit_id" ref="hr_shift.shift_template_form" />
        <field name="arch" type="xml">
            <field name="tz" position="after">
                <field name="default_work_location_id" />
            </field>
        </field>
    </record>
    <record id="shift_template_tree" model="ir.ui.view">
        <field name="name">hr.shift.template.list.work.location</field>
        <field name="model">hr.shift.template</field>
        <field name="inherit_id" ref="hr_shift.shift_template_tree" />
        <field name="arch" type="xml">
            <field name="tz" position="after">
                <field name="default_work_location_id" optional="show" />
            </field>
        </field>
    </record>
</odoo>
