<odoo>
    <record id="hr_recruitment_stage_form_offer_pdf" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.offer.pdf</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_id']" position="after">
                <field name="offer_mail_template_id" options="{'no_quick_create': True}" groups="hr_recruitment.group_hr_recruitment_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
