<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_education" model="ir.ui.view">
        <field name="name">hr.employee.form.education.details</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="certificate" position="after">
                <field name="education_status"/>
                <field
                    name="education_course_id"
                    domain="[('degree', '=', certificate)]"
                    invisible="education_status != 'studying'"
                    required="education_status == 'studying' and certificate in ['bachelor', 'specialist', 'master']"
                    options="{'no_create': True}"
                />
            </field>
        </field>
    </record>
</odoo>
