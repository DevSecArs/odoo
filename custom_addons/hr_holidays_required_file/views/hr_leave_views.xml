<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_require_supporting_document" model="ir.ui.view">
        <field name="name">hr.leave.form.require.supporting.document</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supported_attachment_ids']" position="before">
                <field name="leave_type_document_required" invisible="1"/>
            </xpath>
            <xpath expr="//label[@for='supported_attachment_ids']" position="replace">
                <span class="o_form_label"
                    invisible="not leave_type_support_document or state not in ('confirm', 'validate1')">
                    <field name="leave_type_required_document_name"
                        class="oe_inline" readonly="1" nolabel="1"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                <attribute name="required">leave_type_document_required</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_type_view_form_required_document" model="ir.ui.view">
        <field name="name">hr.leave.type.form.required.document</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='support_document']" position="after">
                <field name="document_required"/>
                <field name="required_document_name"
                    invisible="not document_required"
                    required="document_required"/>
            </xpath>
        </field>
    </record>
</odoo>
